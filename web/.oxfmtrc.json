{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "public/**",
    ".vscode/**",
    ".zed/**"
  ],
  "vueIndentScriptAndStyle": false,
  "printWidth": 120, // 每行长度
  "tabWidth": 2, // 制表符长度
  "useTabs": false, // 用制表符号表示缩进或空格
  "semi": false, // 尾随分号
  "singleQuote": true, // 优先使用单引号
  "quoteProps": "as-needed", // 对象属性名是否加引号的规则
  "bracketSpacing": true, // 对象字面量的花括号内外是否保留空格
  "trailingComma": "none", // 多行结构（数组 / 对象 / 函数参数）是否加尾随逗号
  "jsxBracketSameLine": false, // JSX 标签的闭合括号是否和最后一行内容同一行
  "arrowParens": "always", // 箭头函数的参数是否强制加括号
  "insertPragma": false, // 是否在格式化后的文件顶部插入格式化指令注释（/** @format */）
  "requirePragma": false, // 是否仅格式化包含 /** @format */ 注释的文件
  "proseWrap": "never", // Markdown 等纯文本内容的换行规则（oxfmt 支持 Markdown 格式化）
  "htmlWhitespaceSensitivity": "strict" // HTML/JSX 中空格的敏感度规则（影响空格是否被删除）
}
